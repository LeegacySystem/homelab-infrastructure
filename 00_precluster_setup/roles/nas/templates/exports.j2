# /etc/exports configuration for k8s-nas-00
# Managed by Ansible - changes will be overwritten

# NFSv4 root for Linux clients (fsid=0)
{% for client in nfs_clients %}
/export   {{ client.ip }}(rw,sync,no_subtree_check,fsid=0,all_squash,anonuid={{ client.anonuid | default(1000) }},anongid={{ client.anongid | default(1000) }}){{ ' \\' if not loop.last else '' }}
{% if loop.last %}          {{ client.ip }}(rw,sync,no_subtree_check,all_squash,anonuid={{ client.anonuid | default(1000) }},anongid={{ client.anongid | default(1000) }}){% endif %}
{% endfor %}

# Media export for nodes and Windows clients
{% for export in nfs_media_exports | default([]) %}
/export/media {{ export.client }}(rw,sync,no_subtree_check,fsid=1,all_squash,anonuid={{ export.anonuid | default(0) }},anongid={{ export.anongid | default(0) }}{{ ',insecure' if export.insecure | default(false) else '' }})
{% endfor %}

# Nextcloud data export (www-data = uid/gid 33)
{% for client in nfs_nextcloud_clients %}
/export/nextcloud-data  {{ client.ip }}(rw,fsid=1,sync,no_subtree_check,root_squash,all_squash,anonuid=33,anongid=33){{ ' \\' if not loop.last else '' }}
{% if loop.last %}          {{ client.ip }}(rw,fsid=1,sync,no_subtree_check,root_squash,all_squash,anonuid=33,anongid=33){% endif %}
{% endfor %}
